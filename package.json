  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/stage-pi-node-modules.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:pi-bridge": "node --test pi-bridge/*.test.mjs",
    "test:remote": "node --test src-tauri/remote/*.test.mjs",
    "stage:pi-deps": "node scripts/stage-pi-node-modules.mjs",
    "test:pi-cursor-live": "PATH=/opt/homebrew/bin:$PATH node pi-bridge/live-test.mjs",
    "test:pi-openrouter-live": "PATH=/opt/homebrew/bin:$PATH node pi-bridge/live-openrouter-test.mjs",
    "test:pi-interview-live": "PATH=/opt/homebrew/bin:$PATH node pi-bridge/interview-live/run.mjs"
  },
  "engines": {
    "node": ">=22.19.0"
  },

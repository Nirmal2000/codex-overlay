{
  "name": "codex-overlay",
  "private": false,
  "version": "0.1.9",
  "description": "A private macOS interview assistant with Realtime and Pi SDK answer lanes.",
  "author": {
    "name": "Nirmal"
  },
  "license": "GPL-3.0",
  "homepage": "https://github.com/Nirmal2000/codex-overlay#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nirmal2000/codex-overlay.git"
  },
  "bugs": {
    "url": "https://github.com/Nirmal2000/codex-overlay/issues"
  },
  "keywords": [
    "ai-assistant",
    "tauri",
    "desktop-app",
    "privacy-first",
    "open-source",
    "meeting-assistant",
    "speech-to-text",
    "llm",
    "chatgpt",
    "claude",
    "cluely-alternative",
    "typescript",
    "react",
    "rust"

# Required for the Quick answer lane.
OPENAI_API_KEY=

# Required for microphone and system-audio transcription.
XAI_API_KEY=

# Optional: required only for OpenRouter-backed Pi models.
OPENROUTER_API_KEY=

# Optional: required only for Cursor-backed Pi models.
CURSOR_API_KEY=

# Optional: override the Node executable used by the Pi bridge.
PI_NODE_BIN=

# Optional: override the Pi bridge entry point during development.
PI_BRIDGE_PATH=
